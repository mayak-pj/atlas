/* Цвета и размеры подставляются из tokens.json (знак доллара + имя токена). Своих цветов здесь нет. */
QWidget { background: $bg; color: $text; font-family: $font_ui; font-size: ${font_md}px; }
QToolTip { background: $panel_2; color: $text; border: 1px solid $border_strong; padding: 4px 8px; }
QLabel { background: transparent; }
QLabel[role="muted"] { color: $muted; }
QLabel[role="dim"] { color: $text_dim; }
QLabel[role="caption"] { color: $muted; font-size: ${font_sm}px; font-weight: 600; }
QLabel[role="heading"] { font-size: ${font_lg}px; font-weight: 700; }
QLabel[role="title"] { font-size: ${font_xl}px; font-weight: 800; }
QLabel[role="kpi"] { font-size: 30px; font-weight: 800; }
QLabel[role="kpi"][tone="defect"] { color: $defect; }
QLabel[role="kpi"][tone="type2"] { color: $type2; }
QLabel[role="mono"] { font-family: $font_mono; color: $muted; }
QLabel[role="warn"] { color: $type2; }

QFrame[role="panel"] { background: $panel; border: 1px solid $border; border-radius: ${radius_md}px; }
QFrame[role="panel"] QLabel { background: transparent; }
QWidget[role="plain"] { background: transparent; }
QScrollArea[role="plain"], QScrollArea[role="plain"] > QWidget > QWidget { background: transparent; }
QFrame[role="folder"] { background: $panel_alt; border: 1px solid $border; border-radius: ${radius_md}px; }
QFrame[role="folder"]:hover { border-color: $border_strong; }
QFrame[role="folder"][on="true"] { border-color: $accent; background: $accent_soft; }
QFrame[role="folder"] QLabel { background: transparent; }
QFrame[role="type-card"] { background: $panel; border: 1px solid $border; border-radius: ${radius_md}px; }
QFrame[role="type-card"]:hover { border-color: $border_strong; }
QFrame[role="type-card"][new="true"] { border-color: $type2; }
QFrame[role="type-card"][on="true"] { border-color: $accent; }
QFrame[role="type-card"][archived="true"] QLabel { color: $muted; }
QFrame[role="type-card"] QLabel { background: transparent; }
QFrame[role="rule"] { background: $panel_alt; border: 1px solid $border; border-radius: ${radius_md}px; }
QFrame[role="rule"][new="true"] { border-color: $type2; }
QFrame[role="rule"] QLabel { background: transparent; }
QLabel[role="thumb"] { border: 1px solid $border; border-radius: ${radius_sm}px; background: $panel; }
QLabel[role="pill"][tone="muted"] { background: $panel_2; color: $text_dim; }
QPushButton[role="archive"] { border-color: $defect; color: $defect; background: transparent; }
QPushButton[role="archive"]:hover { background: $defect_soft; }
QPushButton[role="restore"] { border-color: $ok; color: $ok; background: transparent; }
QPushButton[role="restore"]:hover { background: $ok_soft; }
QPushButton[role="archive"]:disabled, QPushButton[role="restore"]:disabled { border-color: $border; color: $disabled; }
QPushButton[role="chip"] { border-radius: 16px; min-height: 32px; padding: 0 12px; background: $panel; border: 1px solid $border_strong; color: $text_dim; }
QPushButton[role="chip"]:hover { border-color: $accent; color: $text; }
QPushButton[role="chip"]:checked { background: $accent_soft; border-color: $accent; color: $text; }
QLabel[role="folder-title"] { font-weight: 700; }
QLabel[role="ok"] { color: $ok; font-size: ${font_sm}px; }
QFrame[role="hsep"] { background: $border; border: none; min-height: 1px; max-height: 1px; }
QLabel[role="pill"] { border: 1px solid transparent; border-radius: 6px; padding: 1px 8px; min-height: 16px; font-size: ${font_sm}px; font-weight: 700; }
QLabel[role="pill"][tone="ok"] { border: 1px solid transparent; border-radius: 6px; background: $ok_soft; color: $ok; }
QLabel[role="pill"][tone="type2"] { border: 1px solid transparent; border-radius: 6px; background: $type2_soft; color: $type2; }
QLabel[role="pill"][tone="type3"] { border: 1px solid transparent; border-radius: 6px; background: $type3_soft; color: $type3; }
QLabel[role="pill"][tone="type4"] { border: 1px solid transparent; border-radius: 6px; background: $type4_soft; color: $type4; }
QLabel[role="pill"][tone="type5"] { border: 1px solid transparent; border-radius: 6px; background: $type5_soft; color: $type5; }
QLabel[role="pill"][tone="type6"] { border: 1px solid transparent; border-radius: 6px; background: $type6_soft; color: $type6; }
QLabel[role="pill"][tone="type7"] { border: 1px solid transparent; border-radius: 6px; background: $type7_soft; color: $type7; }
QLabel[role="pill"][tone="type8"] { border: 1px solid transparent; border-radius: 6px; background: $type8_soft; color: $type8; }
QLabel[role="pill"][tone="type9"] { border: 1px solid transparent; border-radius: 6px; background: $type9_soft; color: $type9; }
QLabel[role="pill"][tone="type10"] { border: 1px solid transparent; border-radius: 6px; background: $type10_soft; color: $type10; }
QLabel[role="pill"][tone="type11"] { border: 1px solid transparent; border-radius: 6px; background: $type11_soft; color: $type11; }
QLabel[role="pill"][tone="type12"] { border: 1px solid transparent; border-radius: 6px; background: $type12_soft; color: $type12; }
QLabel[role="pill"][tone="type13"] { border: 1px solid transparent; border-radius: 6px; background: $type13_soft; color: $type13; }
QLabel[role="pill"][tone="type14"] { border: 1px solid transparent; border-radius: 6px; background: $type14_soft; color: $type14; }
QLabel[role="pill"][tone="type15"] { border: 1px solid transparent; border-radius: 6px; background: $type15_soft; color: $type15; }
QLabel[role="pill"][tone="type16"] { border: 1px solid transparent; border-radius: 6px; background: $type16_soft; color: $type16; }
QLabel[role="pill"][tone="type17"] { border: 1px solid transparent; border-radius: 6px; background: $type17_soft; color: $type17; }
QLabel[role="pill"][tone="type18"] { border: 1px solid transparent; border-radius: 6px; background: $type18_soft; color: $type18; }
QLabel[role="pill"][tone="type19"] { border: 1px solid transparent; border-radius: 6px; background: $type19_soft; color: $type19; }
QLabel[role="pill"][tone="type20"] { border: 1px solid transparent; border-radius: 6px; background: $type20_soft; color: $type20; }
QLabel[role="pill"][tone="defect"] { border: 1px solid transparent; border-radius: 6px; background: $defect_soft; color: $defect; }
QLabel[role="pill"][tone="remark"] { border: 1px solid transparent; border-radius: 6px; background: $remark_soft; color: $remark; }
QFrame[role="alert"] { background: $defect_soft; border: 1px solid $defect; border-radius: ${radius_md}px; }
QFrame[role="alert"] QLabel { background: transparent; }
QLabel[role="alert-title"] { color: $defect; font-weight: 700; }
QLabel[role="alert-text"] { color: $text; }
QFrame[role="panel-alt"] { background: $panel_alt; border: 1px solid $border; border-radius: ${radius_md}px; }
QFrame[role="panel-alt"] QLabel { background: transparent; }

QFrame#TopBar { background: $panel; border: none; border-bottom: 1px solid $border; }
QFrame#TopBar QLabel { background: transparent; }
QLabel#Brand { font-size: ${font_lg}px; font-weight: 800; letter-spacing: 2px; }
QFrame#ContextBar { background: $bg; border: none; border-bottom: 1px solid $border; }
QFrame#ContextBar QLabel { background: transparent; color: $text_dim; }
QLabel#KindBadge { background: $accent_soft; color: $link; border: 1px solid $accent; border-radius: 6px; padding: 1px 8px; font-weight: 700; }
QLabel#ContextCurrent { color: $text; font-weight: 600; }
QLabel#ContextPath { font-family: $font_mono; color: $muted; }

QTabBar { background: transparent; qproperty-drawBase: 0; font-weight: 600; }
QTabBar::tab { background: transparent; color: $text_dim; padding: 6px 14px; margin: 0 2px; border: none;
               border-bottom: 2px solid transparent; min-height: ${control_h}px; }
QTabBar::tab:hover { color: $text; }
QTabBar::tab:selected { color: $accent; border-bottom: 2px solid $accent; }
QLabel#TabBadge { background: $type2; color: $on_accent; border-radius: 8px; padding: 0 6px; font-size: ${font_sm}px; font-weight: 700; }

QPushButton { background: $panel_2; color: $text; border: 1px solid $border_strong; border-radius: ${radius_sm}px;
              padding: 0 14px; min-height: ${control_h}px; }
QPushButton:hover { border-color: $accent; }
QPushButton:disabled { color: $disabled; border-color: $border; }
QPushButton[tone="ok"]:checked { background: $ok_soft; border-color: $ok; color: $ok; }
QPushButton[tone="type2"]:checked { background: $type2_soft; border-color: $type2; color: $type2; }
QPushButton[tone="type3"]:checked { background: $type3_soft; border-color: $type3; color: $type3; }
QPushButton[tone="type4"]:checked { background: $type4_soft; border-color: $type4; color: $type4; }
QPushButton[tone="type5"]:checked { background: $type5_soft; border-color: $type5; color: $type5; }
QPushButton[tone="type6"]:checked { background: $type6_soft; border-color: $type6; color: $type6; }
QPushButton[tone="type7"]:checked { background: $type7_soft; border-color: $type7; color: $type7; }
QPushButton[tone="type8"]:checked { background: $type8_soft; border-color: $type8; color: $type8; }
QPushButton[tone="type9"]:checked { background: $type9_soft; border-color: $type9; color: $type9; }
QPushButton[tone="type10"]:checked { background: $type10_soft; border-color: $type10; color: $type10; }
QPushButton[tone="type11"]:checked { background: $type11_soft; border-color: $type11; color: $type11; }
QPushButton[tone="type12"]:checked { background: $type12_soft; border-color: $type12; color: $type12; }
QPushButton[tone="type13"]:checked { background: $type13_soft; border-color: $type13; color: $type13; }
QPushButton[tone="type14"]:checked { background: $type14_soft; border-color: $type14; color: $type14; }
QPushButton[tone="type15"]:checked { background: $type15_soft; border-color: $type15; color: $type15; }
QPushButton[tone="type16"]:checked { background: $type16_soft; border-color: $type16; color: $type16; }
QPushButton[tone="type17"]:checked { background: $type17_soft; border-color: $type17; color: $type17; }
QPushButton[tone="type18"]:checked { background: $type18_soft; border-color: $type18; color: $type18; }
QPushButton[tone="type19"]:checked { background: $type19_soft; border-color: $type19; color: $type19; }
QPushButton[tone="type20"]:checked { background: $type20_soft; border-color: $type20; color: $type20; }
QPushButton[tone="defect"]:checked { background: $defect_soft; border-color: $defect; color: $defect; }
QPushButton[tone="remark"]:checked { background: $remark_soft; border-color: $remark; color: $remark; }
QPushButton[role="primary"] { background: $accent; color: $on_accent; border: none; font-weight: 700; font-size: ${font_lg}px;
                              min-height: 48px; padding: 0 28px; border-radius: 8px; }
QPushButton[role="primary"]:hover { background: $accent_hover; }
QPushButton[role="primary"]:disabled { background: $panel_2; color: $disabled; }
QPushButton[role="dashed"] { background: transparent; color: $text_dim; border: 1px dashed $border_strong; border-radius: 22px; min-height: 44px; }
QPushButton[role="dashed"]:hover { border-color: $accent; color: $text; }
QPushButton[role="icon"] { padding: 0; min-width: ${control_h}px; max-width: ${control_h}px; background: transparent; border: 1px solid transparent; }
QPushButton[role="icon"]:hover { border-color: $border_strong; background: $panel_2; }

QLineEdit { background: $panel; border: 1px solid $border_strong; border-radius: ${radius_sm}px; padding: 0 10px; min-height: ${control_h}px;
            selection-background-color: $accent_soft; }
QLineEdit:focus { border-color: $accent; }
QPlainTextEdit, QSpinBox { background: $panel; border: 1px solid $border_strong; border-radius: ${radius_sm}px; padding: 2px 6px;
                           selection-background-color: $accent_soft; }
QPlainTextEdit:focus, QSpinBox:focus { border-color: $accent; }
QDialog { background: $bg; }
QMessageBox, QInputDialog { background: $panel; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: $border_strong; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QStatusBar { background: $panel; color: $muted; border-top: 1px solid $border; }
QStatusBar QLabel { color: $muted; }

QPushButton:checked { background: $accent_soft; border-color: $accent; }
QFrame#PhotoViewCaption { background: $bg; border-radius: 6px; }
QLabel#PhotoViewTag { background: $accent_soft; color: $link; border-radius: 4px; padding: 1px 6px; font-size: ${font_sm}px; font-weight: 700; }
QLabel#PhotoViewTag[reference="true"] { background: $ok_soft; color: $ok; }
QWidget#PhotoView { background: $photo_bg; border: 1px solid $border; border-radius: 8px; }
QWidget#PhotoView[active="true"] { border: 2px solid $accent; }
QPushButton[role="square"] { padding: 0; min-width: ${control_h}px; max-width: ${control_h}px; }
QPushButton[role="mini"] { min-height: 22px; padding: 0 10px; font-size: ${font_sm}px; color: $text_dim; }
QPushButton[role="mini"]:checked { color: $text; }
QFrame[role="vsep"] { background: $border_strong; border: none; min-width: 1px; max-width: 1px; min-height: 24px; max-height: 24px; }
QLabel#PhotoViewMessage { background: $panel; color: $text_dim; border: 1px solid $border; border-radius: ${radius_sm}px; padding: 6px 12px; }
QLabel#PhotoViewNote { background: $panel; color: $text_dim; border: 1px solid $border; border-radius: ${radius_sm}px; padding: 2px 8px; font-size: ${font_sm}px; }
